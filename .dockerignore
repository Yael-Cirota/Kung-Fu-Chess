.git/
.claude/
ui/frames/
__pycache__/
**/__pycache__/
*.db
*.log
*.pyc

.dockerignore
Dockerfile
Dockerfile.loadtest
docker-compose.yml
htmlcov/
.pytest_cache/
.import_linter_cache/
.coverage
